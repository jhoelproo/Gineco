new file mode 100644
index 0000000..05c4bc4
--- /dev/null
+++ b/ADMISION_PYSIDE6_V15/derivaciones_gineco.py
@@ -0,0 +1,119 @@
+"""Entrega durable de admisiones al consultorio de ginecología."""
+
+import json
+import os
+import re
+import uuid
+from datetime import datetime
+from email.message import Message
+from urllib.error import HTTPError
+from urllib.request import HTTPRedirectHandler, Request, build_opener
+
+
+class SinRedireccion(HTTPRedirectHandler):
+    def redirect_request(self, req, fp, code, msg, headers, newurl):
+        return None
+
+
+def leer_configuracion(nombre):
+    valor = os.environ.get(nombre, "")
+    if valor or os.name != "nt":
+        return valor
+    import winreg
+
+    try:
+        with winreg.OpenKey(winreg.HKEY_CURRENT_USER, "Environment") as entorno:
+            return str(winreg.QueryValueEx(entorno, nombre)[0])
+    except FileNotFoundError:
+        return ""
+
+
+def preparar_bandeja(conn):
+    if conn.execute(
+        "SELECT 1 FROM sqlite_master WHERE type='table' AND name='gineco_envio'"
+    ).fetchone():
+        return
+    conn.execute("""CREATE TABLE IF NOT EXISTS gineco_envio(
+        visita INTEGER PRIMARY KEY REFERENCES atenciones(id) ON DELETE CASCADE, sobre TEXT)""")
+
+
+def hora_de_llegada(datos):
+    hora, _, periodo = datos["Hora"].strip().upper().partition(" ")
+    formato = "%d/%m/%Y %I:%M" if periodo else "%d/%m/%Y %H:%M"
+    llegada = datetime.strptime(f"{datos['Fecha']} {hora}", formato)
+    if periodo == "PM":
+        llegada = llegada.replace(hour=llegada.hour + 12)
+    return llegada.isoformat()
+
+
+def encolar(conn, visita, hoja, datos):
+    if hoja != "GINECOLOGIA":
+        return
+    campos = {
+        clave: str(datos.get(origen) or "").strip()
+        for clave, origen in (
+            ("nombre", "Nombre"),
+            ("cedula", "Cédula"),
+            ("ars", "Aseguradora (ARS)"),
+            ("telefono", "Teléfono"),
+            ("direccion", "Dirección"),
+            ("nacionalidad", "Nacionalidad"),
+        )
+    }
+    nss = str(datos.get("NSS") or "").strip()
+    campos["nss"] = nss if nss.isdecimal() else ""
+    if datos.get("Unidad") == "Años":
+        campos["edad"] = str(datos.get("Edad_num", ""))
+    sobre = dict(
+        id=str(uuid.uuid4()),
+        visita=visita,
+        llegada=hora_de_llegada(datos),
+        prioridad="",
+        campos=campos,
+    )
+    conn.execute(
+        "INSERT INTO gineco_envio(visita,sobre) VALUES (?,?)",
+        (visita, json.dumps(sobre, ensure_ascii=False)),
+    )
+
+
+def enviar(sobre):
+    proyecto = leer_configuracion("GINECO_PROYECTO")
+    clave = leer_configuracion("GINECO_CLAVE_PUBLICA")
+    token = leer_configuracion("GINECO_TOKEN_ADMISION")
+    if not (
+        re.fullmatch("[a-z0-9]{20}", proyecto)
+        and clave.startswith("sb_publishable_")
+        and token
+    ):
+        raise ValueError("Falta configurar el enlace con Ginecología.")
+    datos = json.loads(sobre)
+    datos["prioridad"] = ""
+    datos["campos"].pop("motivo", None)
+    peticion = Request(
+        f"https://{proyecto}.supabase.co/rest/v1/rpc/enviar_derivacion",
+        data=json.dumps(datos, ensure_ascii=False).encode(),
+        method="POST",
+        headers={
+            "Content-Type": "application/json",
+            "apikey": clave,
+            "x-gineco-estacion": token,
+        },
+    )
+    with build_opener(SinRedireccion()).open(peticion, timeout=8) as respuesta:
+        if respuesta.status not in (200, 204):
+            raise HTTPError(
+                peticion.full_url, respuesta.status, "Envío rechazado", Message(), None
+            )
+
+
+def entregar_pendientes(conn, entregar=enviar):
+    filas = conn.execute(
+        """SELECT g.visita,g.sobre FROM gineco_envio g JOIN atenciones a ON a.id=g.visita
+           WHERE g.sobre IS NOT NULL AND a.estado='ACTIVA' ORDER BY g.visita LIMIT 50"""
+    ).fetchall()
+    for visita, sobre in filas:
+        entregar(sobre)
+        conn.execute("UPDATE gineco_envio SET sobre=NULL WHERE visita=?", (visita,))
+        conn.commit()
+    return len(filas)
